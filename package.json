{
  "name": "intellect-memory",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript SDK and shared contracts for the Intellect Memory API",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  }
}
