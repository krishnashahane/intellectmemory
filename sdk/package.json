{
  "name": "@intellect-memory/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Intellect Memory API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
